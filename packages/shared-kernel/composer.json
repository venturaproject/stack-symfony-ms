{
    "name": "boilerplate/shared-kernel",
    "version": "1.0.0",
    "description": "Small shared package for generic domain primitives, application bus ports, and framework adapters (CQRS, HTTP/security, and messaging) used by the microservices.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.5.12",
        "symfony/messenger": "7.4.*",
        "symfony/amqp-messenger": "7.4.*",
        "symfony/http-kernel": "7.4.*",
        "symfony/http-foundation": "7.4.*",
        "symfony/event-dispatcher": "7.4.*",
        "symfony/dependency-injection": "7.4.*",
        "symfony/security-core": "7.4.*",
        "symfony/security-http": "7.4.*",
        "lexik/jwt-authentication-bundle": "^3.1"
    },
    "autoload": {
        "psr-4": {
            "SharedKernel\\": "src/"
        }
    }
}
