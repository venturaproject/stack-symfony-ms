APP_ENV=dev
APP_SECRET=change_this_in_production_32chars_min

DATABASE_URL="postgresql://postgres:postgres@postgres:5432/notification_db?serverVersion=18&charset=utf8"

# Must match every other service's APP_URL exactly — it's the JWT "iss" claim,
# and JwtClaimsListener rejects any token whose iss doesn't match this value.
APP_URL=http://localhost

###> symfony/framework-bundle ###
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> lexik/jwt-authentication-bundle ###
# No JWT_SECRET_KEY/JWT_PASSPHRASE — verify-only, see lexik_jwt_authentication.yaml.
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
###< lexik/jwt-authentication-bundle ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

###> symfony/messenger ###
MESSENGER_AMQP_DSN=amqp://guest:guest@rabbitmq:5672/%2f
###< symfony/messenger ###
