{% extends 'emails/layout.html.twig' %}

{% block title %}Your password has been changed{% endblock %}

{% block body %}
    <h1>Your password has been changed</h1>
    <p>Your account password was changed.</p>

    <div class="credentials">
        <table>
            <tr>
                <td>Email</td>
                <td>{{ userEmail }}</td>
            </tr>
        </table>
    </div>

    <p class="notice">If you did not request this change, contact support immediately. We will never send your password by email.</p>
{% endblock %}
