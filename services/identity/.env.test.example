APP_ENV=test
APP_SECRET=test-only-secret-do-not-use-in-production-32-chars

DATABASE_URL="postgresql://postgres:postgres@postgres:5432/identity_db_test?serverVersion=18&charset=utf8"

JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=local-development-only-change-before-deployment

JWT_ACCESS_TTL_SECS=900
JWT_REFRESH_TTL_SECS=604800
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
MEDIA_DIR=/tmp/test_media

# No SMTP server / worker available under phpunit — swallow sends, and keep
# Messenger fully synchronous (no doctrine transport table, no queue to drain).
MAILER_DSN=null://null
MESSENGER_TRANSPORT_DSN=in-memory://
